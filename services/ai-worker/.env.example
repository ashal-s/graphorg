# Copy to .env and fill in. Never commit .env.

# Shared secret that apps/web sends in the X-Internal-Secret header.
# Generate one with: openssl rand -hex 32
INTERNAL_SECRET=change-me

# --- Profile 1: local (Ollama) ---
LLM_PROVIDER=local
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b-instruct

# --- Profile 2: hosted (Fireworks) --- uncomment these and comment out the local block
# LLM_PROVIDER=hosted
# LLM_BASE_URL=https://api.fireworks.ai/inference/v1
# LLM_API_KEY=fw_your_key_here
# LLM_MODEL=accounts/fireworks/models/<model-id-from-their-model-library>