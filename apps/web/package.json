{
  "name": "@graphorg/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:report": "playwright show-report playwright-report",
    "db:generate": "dotenv -e .env.local -- drizzle-kit generate",
    "postdb:generate": "prettier --write drizzle",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "db:seed": "dotenv -e .env.local -- tsx scripts/seed.ts",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio",
    "analytics:export": "tsx scripts/export-analytics-sample.ts",
    "email:test": "dotenv -e .env.local -- tsx scripts/send-test-email.ts",
    "email:dev": "email dev --dir emails --port 3334"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@graphorg/types": "*",
    "@launchdarkly/node-server-sdk": "^9.15.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/instrumentation-http": "^0.223.0",
    "@opentelemetry/instrumentation-runtime-node": "^0.36.1",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@sentry/nextjs": "^11.8.0",
    "@vercel/functions": "^3.10.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.33.0",
    "next": "16.4.2",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "posthog-js": "^1.438.12",
    "react": "19.2.8",
    "react-dom": "19.3.1",
    "react-email": "^6.11.3",
    "resend": "^6.34.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@graphorg/tsconfig": "*",
    "@playwright/test": "^1.64.1",
    "@react-email/ui": "^6.11.3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "pino-pretty": "^13.2.0",
    "shadcn": "^4.18.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12"
  }
}
